root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
max_line_length = 100

[*.{xml,html}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{js,ts}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.po]
trim_trailing_whitespace = false
