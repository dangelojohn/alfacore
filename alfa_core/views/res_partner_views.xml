<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_partner_form_alfa_core" model="ir.ui.view">
    <field name="name">res.partner.form.alfa_core</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="AlfaCore" name="alfa_core"
              invisible="not is_company and not customer_rank">
          <group>
            <group string="Identity">
              <field name="alfa_core_customer"/>
              <field name="alfa_core_signup_date" readonly="not alfa_core_customer"/>
              <field name="alfa_core_customer_tier" readonly="1"/>
              <field name="alfa_core_lifetime_spend" readonly="1" widget="monetary"/>
            </group>
            <group string="Preferences">
              <field name="alfa_core_preferred_channel"/>
              <field name="alfa_core_active_subscription_id" readonly="1"/>
            </group>
          </group>
          <group string="PIPEDA Consent" groups="alfa_core.group_pipeda_officer">
            <field name="alfa_core_pipeda_consent_version"/>
            <field name="alfa_core_pipeda_consent_date"/>
          </group>
          <field name="alfa_core_subscription_ids" readonly="1">
            <list>
              <field name="name"/>
              <field name="plan_id"/>
              <field name="start_date"/>
              <field name="end_date"/>
              <field name="state" widget="badge"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>

</odoo>
