<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_subscription_plan_list" model="ir.ui.view">
    <field name="name">alfa_core.subscription.plan.list</field>
    <field name="model">alfa_core.subscription.plan</field>
    <field name="arch" type="xml">
      <list string="Subscription Plans">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="monthly_price" widget="monetary"/>
        <field name="annual_price" widget="monetary"/>
        <field name="subscription_count"/>
        <field name="inference_zde_default" widget="boolean_toggle"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="view_subscription_plan_form" model="ir.ui.view">
    <field name="name">alfa_core.subscription.plan.form</field>
    <field name="model">alfa_core.subscription.plan</field>
    <field name="arch" type="xml">
      <form string="Subscription Plan">
        <header>
          <button name="action_view_subscriptions" type="object"
                  string="View Subscribers" class="btn-secondary"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_subscriptions" type="object"
                    class="oe_stat_button" icon="fa-users">
              <field name="subscription_count" widget="statinfo" string="Subscribers"/>
            </button>
          </div>
          <widget name="web_ribbon" title="Archived"
                  bg_color="text-bg-danger" invisible="active"/>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="e.g. Premium"/></h1>
          </div>
          <group>
            <group>
              <field name="code" placeholder="e.g. premium"/>
              <field name="sequence"/>
              <field name="product_id"/>
              <field name="active" invisible="1"/>
            </group>
            <group>
              <field name="monthly_price" widget="monetary"/>
              <field name="annual_price" widget="monetary"/>
              <field name="inference_zde_default"/>
            </group>
          </group>
          <notebook>
            <page string="Description">
              <field name="description" placeholder="Customer-facing plan description..."/>
            </page>
            <page string="Features">
              <field name="features">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="benefit_type"/>
                  <field name="value"/>
                  <field name="comparison_visible" widget="boolean_toggle"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_subscription_plan_kanban" model="ir.ui.view">
    <field name="name">alfa_core.subscription.plan.kanban</field>
    <field name="model">alfa_core.subscription.plan</field>
    <field name="arch" type="xml">
      <kanban default_order="sequence">
        <field name="name"/>
        <field name="code"/>
        <field name="monthly_price"/>
        <field name="annual_price"/>
        <field name="subscription_count"/>
        <field name="color"/>
        <templates>
          <t t-name="card">
            <div class="o_kanban_card_content">
              <strong><field name="name"/></strong>
              <div class="text-muted"><field name="code"/></div>
              <div class="mt-2">
                <span>CAD $<field name="monthly_price"/>/mo</span>
                <span class="mx-2">·</span>
                <span>$<field name="annual_price"/>/yr</span>
              </div>
              <div class="mt-2 text-muted">
                <field name="subscription_count"/> subscribers
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="action_subscription_plan" model="ir.actions.act_window">
    <field name="name">Subscription Plans</field>
    <field name="res_model">alfa_core.subscription.plan</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create your first subscription plan</p>
      <p>Define Basic, Premium, and Pro tiers. Customers subscribe to a plan; tier benefits drive Configurator behavior.</p>
    </field>
  </record>

</odoo>
