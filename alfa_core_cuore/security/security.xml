<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!--
      Built on AlfaCore's vocabulary group_user < group_advisor < group_manager.
      Advisors and managers can already import (the service method checks
      alfa_core.group_advisor); this group lets a shop mechanic import and read
      CUORE data without any other AlfaCore rights.
    -->
    <record id="group_cuore_mechanic" model="res.groups">
      <field name="name">AlfaCore / CUORE Mechanic</field>
      <field name="privilege_id" ref="alfa_core.alfa_core_privilege"/>
      <field name="implied_ids" eval="[(4, ref('alfa_core.group_user'))]"/>
      <field name="comment">Can run the CUORE import wizard and read imported scans, hypotheses and steps. Cannot edit CUORE readings, hypothesis status or evidence.</field>
    </record>

  </data>
</odoo>
