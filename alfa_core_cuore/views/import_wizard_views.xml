<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_cuore_import_wizard_form" model="ir.ui.view">
    <field name="name">alfa.cuore.import.wizard.form</field>
    <field name="model">alfa.cuore.import.wizard</field>
    <field name="arch" type="xml">
      <form>
        <field name="state" invisible="1"/>
        <div class="alert alert-danger" role="alert" invisible="state != 'invalid'">
          This bundle was refused and nothing was imported. See the validation report below.
        </div>
        <div class="alert alert-info" role="alert" invisible="state != 'already'">
          Already imported. Nothing was created. See the bundle record for who imported it and when.
        </div>
        <div class="alert alert-success" role="alert" invisible="state != 'done'">
          Imported. The records created are linked from the bundle.
        </div>

        <group invisible="state != 'upload'">
          <group>
            <field name="file" filename="filename"/>
            <field name="filename" invisible="1"/>
            <field name="sale_order_id"/>
          </group>
          <div class="text-muted">
            Choose a <code>.cuore.zip</code> exported from CUORE. The file is checked for
            integrity and schema first; nothing is written until you press Import.
            The VIN must already exist in AlfaCore: customers and vehicles are never created here.
          </div>
        </group>

        <group invisible="state == 'upload'" string="Bundle">
          <group>
            <field name="bundle_uuid"/>
            <field name="kind"/>
            <field name="station_id"/>
            <field name="vin"/>
            <field name="vehicle_id"/>
          </group>
          <group>
            <field name="created_at"/>
            <field name="age_days"/>
            <field name="finalized"/>
            <field name="existing_bundle_id" invisible="state not in ('already', 'invalid')"/>
          </group>
        </group>

        <group invisible="state not in ('preview', 'done')" string="What will be created">
          <group invisible="kind != 'scan'">
            <field name="n_dtc_active"/>
            <field name="n_dtc_history"/>
            <field name="n_dtc_not_run"/>
          </group>
          <group invisible="kind != 'job'">
            <field name="n_hypotheses"/>
            <field name="n_hypotheses_deleted"/>
            <field name="n_steps"/>
            <field name="class_summary"/>
          </group>
        </group>

        <group invisible="state == 'upload'" string="Validation report">
          <field name="report" widget="text" nolabel="1" colspan="2" readonly="1"/>
        </group>

        <footer>
          <button name="action_validate" string="Validate" type="object" class="btn-primary"
                  invisible="state != 'upload'"/>
          <button name="action_import" string="Import" type="object" class="btn-primary"
                  invisible="state != 'preview'"/>
          <button name="action_open_bundle" string="Open bundle" type="object" class="btn-primary"
                  invisible="state not in ('already', 'done')"/>
          <button name="action_back" string="Choose another file" type="object"
                  invisible="state not in ('invalid', 'preview', 'already')"/>
          <button string="Close" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_cuore_import_wizard" model="ir.actions.act_window">
    <field name="name">Import CUORE bundle</field>
    <field name="res_model">alfa.cuore.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

</odoo>
