<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record id="template_spring_readiness" model="alfa_core_inspection.template">
      <field name="name">Spring Readiness · 18-Point</field>
      <field name="code">spring_readiness</field>
      <field name="version">1</field>
      <field name="state">published</field>
      <field name="description">Post-winter inspection. Verifies brake, tire, fluid, and underbody integrity after Toronto winter exposure.</field>
      <field name="estimated_duration_minutes">45</field>
      <field name="requires_lift" eval="True"/>
      <field name="fits_platform_ids" eval="[(4, ref('alfa_fleet.platform_giorgio'))]"/>
    </record>

    <record id="item_spring_brake_pads_front" model="alfa_core_inspection.template_item">
      <field name="template_id" ref="template_spring_readiness"/>
      <field name="name">Front brake pad thickness</field>
      <field name="category">brakes</field>
      <field name="measurement_type">measurement</field>
      <field name="measurement_units">mm</field>
      <field name="threshold_pass">5.0</field>
      <field name="threshold_warn">3.0</field>
      <field name="is_safety_critical" eval="True"/>
      <field name="sequence">10</field>
    </record>

    <record id="item_spring_brake_pads_rear" model="alfa_core_inspection.template_item">
      <field name="template_id" ref="template_spring_readiness"/>
      <field name="name">Rear brake pad thickness</field>
      <field name="category">brakes</field>
      <field name="measurement_type">measurement</field>
      <field name="measurement_units">mm</field>
      <field name="threshold_pass">4.0</field>
      <field name="threshold_warn">2.5</field>
      <field name="is_safety_critical" eval="True"/>
      <field name="sequence">20</field>
    </record>

    <record id="item_spring_brake_fluid" model="alfa_core_inspection.template_item">
      <field name="template_id" ref="template_spring_readiness"/>
      <field name="name">Brake fluid condition (moisture %)</field>
      <field name="category">fluids</field>
      <field name="measurement_type">measurement</field>
      <field name="measurement_units">%</field>
      <field name="threshold_pass">2.0</field>
      <field name="threshold_warn">3.0</field>
      <field name="is_safety_critical" eval="True"/>
      <field name="sequence">30</field>
    </record>

    <record id="item_spring_tire_tread" model="alfa_core_inspection.template_item">
      <field name="template_id" ref="template_spring_readiness"/>
      <field name="name">Tire tread depth (lowest of 4)</field>
      <field name="category">tires</field>
      <field name="measurement_type">measurement</field>
      <field name="measurement_units">mm</field>
      <field name="threshold_pass">4.0</field>
      <field name="threshold_warn">2.5</field>
      <field name="is_safety_critical" eval="True"/>
      <field name="sequence">40</field>
    </record>

    <record id="item_spring_underbody" model="alfa_core_inspection.template_item">
      <field name="template_id" ref="template_spring_readiness"/>
      <field name="name">Underbody corrosion inspection</field>
      <field name="category">body</field>
      <field name="measurement_type">photo</field>
      <field name="sequence">50</field>
    </record>

    <record id="item_spring_cv_boots" model="alfa_core_inspection.template_item">
      <field name="template_id" ref="template_spring_readiness"/>
      <field name="name">CV boot integrity (4 corners)</field>
      <field name="category">drivetrain</field>
      <field name="measurement_type">pass_fail</field>
      <field name="sequence">60</field>
    </record>

    <record id="item_spring_suspension_visual" model="alfa_core_inspection.template_item">
      <field name="template_id" ref="template_spring_readiness"/>
      <field name="name">Suspension visual (struts, bushings, sway links)</field>
      <field name="category">suspension</field>
      <field name="measurement_type">pass_fail</field>
      <field name="sequence">70</field>
    </record>

    <record id="item_spring_battery" model="alfa_core_inspection.template_item">
      <field name="template_id" ref="template_spring_readiness"/>
      <field name="name">Battery state of charge</field>
      <field name="category">electrical</field>
      <field name="measurement_type">measurement</field>
      <field name="measurement_units">V</field>
      <field name="threshold_pass">12.4</field>
      <field name="threshold_warn">12.0</field>
      <field name="sequence">80</field>
    </record>

    <!-- Track-day template (Pro-tier feature) -->
    <record id="template_track_prep" model="alfa_core_inspection.template">
      <field name="name">Track Day Prep · Quadrifoglio</field>
      <field name="code">track_prep_qv</field>
      <field name="version">1</field>
      <field name="state">published</field>
      <field name="description">Pre-track-day inspection for Giulia/Stelvio Quadrifoglio. Brake, fluid, tire pressure, and torque-spec verification before circuit use.</field>
      <field name="estimated_duration_minutes">90</field>
      <field name="requires_lift" eval="True"/>
      <field name="fits_platform_ids" eval="[(4, ref('alfa_fleet.platform_giorgio'))]"/>
    </record>

    <record id="item_track_brake_thickness" model="alfa_core_inspection.template_item">
      <field name="template_id" ref="template_track_prep"/>
      <field name="name">Brake pad thickness (front, track-spec)</field>
      <field name="category">brakes</field>
      <field name="measurement_type">measurement</field>
      <field name="measurement_units">mm</field>
      <field name="threshold_pass">7.0</field>
      <field name="threshold_warn">5.0</field>
      <field name="is_safety_critical" eval="True"/>
      <field name="sequence">10</field>
    </record>

    <record id="item_track_brake_fluid" model="alfa_core_inspection.template_item">
      <field name="template_id" ref="template_track_prep"/>
      <field name="name">Brake fluid (DOT 5.1 or RBF600 fresh)</field>
      <field name="category">fluids</field>
      <field name="measurement_type">pass_fail</field>
      <field name="is_safety_critical" eval="True"/>
      <field name="sequence">20</field>
    </record>

    <record id="item_track_wheel_torque" model="alfa_core_inspection.template_item">
      <field name="template_id" ref="template_track_prep"/>
      <field name="name">Wheel torque (110 Nm spec)</field>
      <field name="category">safety</field>
      <field name="measurement_type">pass_fail</field>
      <field name="is_safety_critical" eval="True"/>
      <field name="sequence">30</field>
    </record>

    <record id="item_track_tire_pressure" model="alfa_core_inspection.template_item">
      <field name="template_id" ref="template_track_prep"/>
      <field name="name">Cold tire pressure (track-spec)</field>
      <field name="category">tires</field>
      <field name="measurement_type">measurement</field>
      <field name="measurement_units">PSI</field>
      <field name="threshold_pass">32</field>
      <field name="threshold_warn">28</field>
      <field name="sequence">40</field>
    </record>

  </data>
</odoo>
