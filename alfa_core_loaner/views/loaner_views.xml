<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_loaner_vehicle_list" model="ir.ui.view">
    <field name="name">alfa_core_loaner.vehicle.list</field>
    <field name="model">alfa_core_loaner.vehicle</field>
    <field name="arch" type="xml">
      <list decoration-success="state == 'available'"
            decoration-warning="state == 'allocated'"
            decoration-muted="state in ('maintenance','retired')">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="year"/>
        <field name="model_name"/>
        <field name="license_plate"/>
        <field name="tier_eligibility"/>
        <field name="current_mileage_km"/>
        <field name="state" widget="badge"/>
        <field name="current_allocation_id"/>
      </list>
    </field>
  </record>

  <record id="view_loaner_vehicle_form" model="ir.ui.view">
    <field name="name">alfa_core_loaner.vehicle.form</field>
    <field name="model">alfa_core_loaner.vehicle</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="year"/>
              <field name="model_name"/>
              <field name="platform_id"/>
              <field name="trim_id"/>
              <field name="color"/>
            </group>
            <group>
              <field name="license_plate"/>
              <field name="vin"/>
              <field name="seats"/>
              <field name="current_mileage_km"/>
              <field name="tier_eligibility"/>
              <field name="location_id"/>
            </group>
          </group>
          <group>
            <field name="utilization_pct_30d" widget="progressbar"/>
            <field name="current_allocation_id"/>
          </group>
          <notebook>
            <page string="Allocation History">
              <field name="allocation_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="partner_id"/>
                  <field name="pickup_date"/>
                  <field name="actual_return_date"/>
                  <field name="days_actual"/>
                  <field name="miles_driven"/>
                  <field name="state" widget="badge"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_loaner_vehicle" model="ir.actions.act_window">
    <field name="name">Loaner Fleet</field>
    <field name="res_model">alfa_core_loaner.vehicle</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_allocation_list" model="ir.ui.view">
    <field name="name">alfa_core_loaner.allocation.list</field>
    <field name="model">alfa_core_loaner.allocation</field>
    <field name="arch" type="xml">
      <list decoration-info="state == 'scheduled'"
            decoration-warning="state == 'active'"
            decoration-success="state == 'completed'"
            decoration-muted="state == 'cancelled'">
        <field name="name"/>
        <field name="loaner_vehicle_id"/>
        <field name="partner_id"/>
        <field name="pickup_date"/>
        <field name="scheduled_return_date"/>
        <field name="actual_return_date"/>
        <field name="days_overage" optional="hide"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="view_allocation_form" model="ir.ui.view">
    <field name="name">alfa_core_loaner.allocation.form</field>
    <field name="model">alfa_core_loaner.allocation</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_schedule" type="object" string="Schedule"
                  class="btn-primary" invisible="state != 'draft'"/>
          <!-- Send-for-Signature / Sync-Sig-Status buttons are injected
               by `alfa_core_loaner_sign` when Enterprise's `sign` is
               installed. The Pickup button below is also gated by
               sign_status in that overlay. -->
          <button name="action_activate" type="object" string="Pickup (Activate)"
                  class="btn-primary"
                  invisible="state != 'scheduled'"/>
          <button name="action_return" type="object" string="Return"
                  class="btn-primary" invisible="state != 'active'"/>
          <button name="action_complete" type="object" string="Close"
                  invisible="state != 'returned'"/>
          <button name="action_cancel" type="object" string="Cancel"
                  invisible="state in ('completed','cancelled')"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="loaner_vehicle_id"/>
              <field name="partner_id"/>
              <field name="customer_vehicle_id"/>
              <field name="sale_order_id"/>
            </group>
            <group>
              <field name="pickup_date"/>
              <field name="scheduled_return_date"/>
              <field name="actual_return_date"/>
              <field name="days_scheduled" readonly="1"/>
              <field name="days_actual" readonly="1"/>
              <field name="days_overage" readonly="1"/>
            </group>
          </group>
          <group>
            <group string="Mileage">
              <field name="pickup_mileage_km"/>
              <field name="return_mileage_km"/>
              <field name="miles_driven" readonly="1"/>
            </group>
            <!-- Signature group is injected by `alfa_core_loaner_sign`. -->
          </group>
          <group>
            <field name="pickup_report_id"/>
            <field name="return_report_id"/>
          </group>
          <field name="notes" placeholder="Internal notes..."/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_allocation_kanban" model="ir.ui.view">
    <field name="name">alfa_core_loaner.allocation.kanban</field>
    <field name="model">alfa_core_loaner.allocation</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="loaner_vehicle_id"/>
        <field name="pickup_date"/>
        <field name="scheduled_return_date"/>
        <field name="state"/>
        <templates>
          <t t-name="card">
            <div class="o_kanban_card_content">
              <strong><field name="name"/></strong>
              <div><field name="partner_id"/></div>
              <div class="text-muted small mt-1"><field name="loaner_vehicle_id"/></div>
              <div class="text-muted small">
                <field name="pickup_date"/> → <field name="scheduled_return_date"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="action_allocation" model="ir.actions.act_window">
    <field name="name">Allocations</field>
    <field name="res_model">alfa_core_loaner.allocation</field>
    <field name="view_mode">kanban,list,form</field>
  </record>

  <record id="view_condition_report_form" model="ir.ui.view">
    <field name="name">alfa_core_loaner.condition_report.form</field>
    <field name="model">alfa_core_loaner.condition_report</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="report_type"/>
              <field name="allocation_id"/>
              <field name="inspector_id"/>
              <field name="inspection_date"/>
            </group>
            <group>
              <field name="exterior_condition"/>
              <field name="interior_condition"/>
              <field name="fuel_level"/>
              <field name="mileage_km"/>
            </group>
          </group>
          <group string="Photos">
            <field name="photo_front" widget="image"/>
            <field name="photo_rear" widget="image"/>
            <field name="photo_left" widget="image"/>
            <field name="photo_right" widget="image"/>
            <field name="photo_interior" widget="image"/>
          </group>
          <field name="damage_notes" placeholder="Any visible damage..."/>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Menus -->
  <menuitem id="menu_allocations" name="Loaner Allocations"
            parent="alfa_core.menu_alfa_core_operations"
            action="action_allocation" sequence="70"/>
  <menuitem id="menu_loaner_fleet" name="Loaner Fleet"
            parent="alfa_core.menu_alfa_core_configuration"
            action="action_loaner_vehicle" sequence="90"/>

</odoo>
