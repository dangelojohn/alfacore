<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Sync sign.request state into allocation.sign_status. Runs every
         5 minutes against allocations waiting for a customer signature. -->
    <record id="cron_sync_signatures" model="ir.cron">
      <field name="name">AlfaCore: sync pending loaner signatures</field>
      <field name="model_id" ref="model_alfa_core_loaner_allocation"/>
      <field name="state">code</field>
      <field name="code">model.cron_sync_pending_signatures()</field>
      <field name="interval_number">5</field>
      <field name="interval_type">minutes</field>
      <field name="active" eval="True"/>
    </record>

  </data>
</odoo>
