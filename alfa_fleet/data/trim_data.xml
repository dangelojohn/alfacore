<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record id="trim_sprint" model="alfa_fleet.trim">
      <field name="name">Sprint</field>
      <field name="code">sprint</field>
      <field name="sequence">10</field>
    </record>

    <record id="trim_ti" model="alfa_fleet.trim">
      <field name="name">Ti</field>
      <field name="code">ti</field>
      <field name="sequence">20</field>
    </record>

    <record id="trim_veloce" model="alfa_fleet.trim">
      <field name="name">Veloce</field>
      <field name="code">veloce</field>
      <field name="sequence">30</field>
    </record>

    <record id="trim_quadrifoglio" model="alfa_fleet.trim">
      <field name="name">Quadrifoglio</field>
      <field name="code">quadrifoglio</field>
      <field name="sequence">40</field>
      <field name="is_performance" eval="True"/>
    </record>

  </data>
</odoo>
