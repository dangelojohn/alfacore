<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_engine_list" model="ir.ui.view">
    <field name="name">alfa_fleet.engine.list</field>
    <field name="model">alfa_fleet.engine</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="platform_id"/>
        <field name="displacement"/>
        <field name="configuration"/>
        <field name="fuel_type"/>
        <field name="horsepower_kw"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="view_engine_form" model="ir.ui.view">
    <field name="name">alfa_fleet.engine.form</field>
    <field name="model">alfa_fleet.engine</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="code"/>
              <field name="platform_id"/>
              <field name="displacement"/>
              <field name="configuration"/>
              <field name="fuel_type"/>
            </group>
            <group>
              <field name="horsepower_kw"/>
              <field name="torque_nm"/>
              <field name="oil_capacity_l"/>
              <field name="default_oil_spec"/>
              <field name="active"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_engine" model="ir.actions.act_window">
    <field name="name">Engines</field>
    <field name="res_model">alfa_fleet.engine</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
