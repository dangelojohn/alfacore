<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_platform_list" model="ir.ui.view">
    <field name="name">alfa_fleet.platform.list</field>
    <field name="model">alfa_fleet.platform</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="vehicle_count"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="view_platform_form" model="ir.ui.view">
    <field name="name">alfa_fleet.platform.form</field>
    <field name="model">alfa_fleet.platform</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="code"/>
              <field name="sequence"/>
            </group>
            <group>
              <field name="vehicle_count"/>
              <field name="active"/>
            </group>
          </group>
          <field name="description"/>
          <notebook>
            <page string="Engines">
              <field name="engine_ids">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="code"/>
                  <field name="displacement"/>
                  <field name="configuration"/>
                  <field name="fuel_type"/>
                  <field name="horsepower_kw"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_platform" model="ir.actions.act_window">
    <field name="name">Platforms</field>
    <field name="res_model">alfa_fleet.platform</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
