<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_sale_order_form_alfa" model="ir.ui.view">
    <field name="name">sale.order.form.alfa</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="alfa_vehicle_id"/>
        <field name="alfa_bay_id"/>
        <field name="alfa_technician_id"/>
      </xpath>
      <xpath expr="//field[@name='state']" position="after">
        <field name="alfa_service_state" widget="badge"/>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Quality Checks" name="alfa_quality">
          <field name="alfa_quality_check_ids">
            <list>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
              <field name="state" widget="badge"
                     decoration-success="state == 'passed'"
                     decoration-danger="state == 'failed'"
                     decoration-warning="state == 'pending'"/>
              <field name="checked_by_id"/>
              <field name="checked_at"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>

  <record id="view_bay_list" model="ir.ui.view">
    <field name="name">alfa_service.bay.list</field>
    <field name="model">alfa_service.bay</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="bay_type"/>
        <field name="lift_type"/>
        <field name="capacity_vehicles"/>
        <field name="current_order_id"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="view_bay_form" model="ir.ui.view">
    <field name="name">alfa_service.bay.form</field>
    <field name="model">alfa_service.bay</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="bay_type"/>
              <field name="lift_type"/>
            </group>
            <group>
              <field name="capacity_vehicles"/>
              <field name="location_id"/>
              <field name="current_order_id"/>
              <field name="active"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_bay" model="ir.actions.act_window">
    <field name="name">Service Bays</field>
    <field name="res_model">alfa_service.bay</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_bays" name="Service Bays"
            parent="alfa_core.menu_alfa_core_configuration"
            action="action_bay" sequence="60"/>

</odoo>
